# OpenRouter — required for the Design Brain (AI generation layer)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional model override (default: google/gemini-flash-1.5)
# Any OpenRouter model ID supporting vision will work.
# OPENROUTER_MODEL=google/gemini-flash-1.5

# Server port (default: 3001)
# PORT=3001
